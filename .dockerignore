# Keep the Docker build context limited to the reviewed runtime source.
.git
.github
.agents
.brain
.npm-sync-test
.pytest_cache
.venv
venv
__pycache__
*.py[cod]
*.egg-info
.ruff_cache
.mypy_cache
node_modules
npm
bench
docs
plugins
tests
work
debug.log
dist
build
*.tgz

# Tests are available only to the Docker `test` stage. The production stages
# copy an explicit runtime allowlist and never copy this directory.
!tests/
!tests/**

# Harness-package fixtures are needed only by the Docker `test` stage. They
# are never copied into the production image.
!.agents/
!.agents/**
!plugins/
!plugins/**

# The npm source is available only to the Docker `npm-test` stage. The runtime
# stages do not copy it, and generated package contents remain excluded.
!npm/
!npm/**
npm/node_modules
npm/vendor
npm/*.tgz
npm/.venv
npm/.uv-cache
