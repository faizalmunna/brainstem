# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Virtual environments
.venv/
venv/

# Per-repo runtime state (created by `brainstem init` when dogfooding on this repo itself)
.brain/

# Local smoke-test environments and scratch artifacts. These are never source
# inputs to a Brainstem release.
.npm-sync-test/
work/
debug.log

# Private development material. Keep planning, evaluation notes, host-test
# records, and collaborator discussion outside the public product history.
.private/
private/
docs/
bench/
.agents/

# npm wrapper package: vendor/ is generated by npm/scripts/sync-vendor.js
# (a copy of src/, not a second source of truth), never hand-edited
node_modules/
npm/vendor/
npm/*.tgz

# OS
.DS_Store
Thumbs.db
