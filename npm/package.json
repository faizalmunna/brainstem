{
  "name": "@faizalmunna/brainstem",
  "version": "0.1.0",
  "description": "npm wrapper for Brainstem, a portable AI engineering agent engine with bounded repository intelligence, independent roles, and durable evidence gates. This is an installer/launcher for the real Python implementation, not a Node reimplementation -- see README.md.",
  "license": "MIT",
  "author": "Faizal Munna",
  "homepage": "https://github.com/faizalmunna/brainstem",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/faizalmunna/brainstem.git"
  },
  "bugs": {
    "url": "https://github.com/faizalmunna/brainstem/issues"
  },
  "bin": {
    "brainstem": "bin/brainstem.js"
  },
  "files": [
    "bin",
    "scripts",
    "vendor",
    "README.md"
  ],
  "scripts": {
    "sync-vendor": "node scripts/sync-vendor.js",
    "prepack": "node scripts/sync-vendor.js",
    "postinstall": "node scripts/setup.js"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "ai",
    "mcp",
    "model-context-protocol",
